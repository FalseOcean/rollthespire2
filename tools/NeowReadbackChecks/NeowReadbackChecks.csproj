<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 與候選版使用相同開關，讓 Enabled 與容量邊界一致。 -->
    <DefineConstants>$(DefineConstants);RT2_NEOW_SMALL_READBACK;RT2_NEOW_COMBINED_READBACK;RT2_NEOW_MEDIUM_READBACK</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Search/FamilyExecution/NeowReadbackTransport.cs" Link="NeowReadbackTransport.cs" />
    <Compile Include="../../Search/FamilyExecution/NeowCandidateDigest.cs" Link="NeowCandidateDigest.cs" />
    <Compile Include="../../Search/FamilyExecution/NeowCombinedReadbackTransport.cs" Link="NeowCombinedReadbackTransport.cs" />
    <Compile Include="../../Search/FamilyExecution/NeowMediumReadbackTransport.cs" Link="NeowMediumReadbackTransport.cs" />
  </ItemGroup>
</Project>
